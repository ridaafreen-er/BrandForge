# All optional. With no keys the app runs in labelled DEMO mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
GEMINI_IMAGE_PROMPT_MODEL=gemini-2.5-flash
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# For production across separate frontend/backend domains use SESSION_COOKIE_SECURE=true
# and SESSION_COOKIE_SAMESITE=none. Use the exact frontend origin in CORS_ORIGINS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Optional provider app credentials. Values are checked only by the backend.
# OAuth remains unavailable until authenticated user ownership and encrypted token storage are implemented.
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=
